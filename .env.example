# 1 = sample data, nothing paid. Set 0 for real checks on Celo mainnet.
MOCK=1

# From `npm run keys`. Never commit these.
AGENT_PRIVATE_KEY=
AGENT_SESSION_KEY=

# The ERC-8021 code Loops House gives you at enrollment (celo_xxxxxxxxxxxx).
ATTRIBUTION_CODE=

# Your live site, used by `npm run register` and the agent card.
PUBLIC_URL=
# Set after `npm run register` prints it.
AGENT_ID=

# What one check costs the user, taken from their tab (USDC).
CHECK_PRICE=0.05

# tab (default): one capped charge per check, agent pays the services.
# direct: agent pays each service straight from the user's wallet (experimental, see README).
PAY_MODE=tab

# Most a single data call may cost (USDC).
MAX_X_SEARCH=0.02
MAX_RPC=0.02

# Database: connect Upstash Redis in Vercel > Storage (free). It sets these two.
# Without it, Vex keeps everything in memory and forgets on restart (fine for demo mode).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Daily automatic checks. Vercel Cron sends this as a Bearer token.
CRON_SECRET=

# Telegram alerts: make a bot with @BotFather, then run `npm run telegram` once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: your own Celo RPC. Defaults to the public one.
CELO_RPC_URL=

# Only for `npm run cli`: a test user's admin key (yours), owner of a test Altana wallet.
TEST_USER_KEY=
